/* ====================================================================
   MNC ENTERPRISE DESIGN TOKENS (GLOBAL THEME DEFINITIONS)
   Adheres to AAA UI/UX design language & high-density display standards.
   ==================================================================== */

:root {
    /* Palette Tokens: Dark Theme / Neon Accent */
    --color-bg-base: #0B0E14;
    --color-bg-surface: #151922;
    --color-bg-elevated: #1F2430;
    --color-border: #2D3342;
    --color-border-subtle: #202634;

    /* Brand / Accent Tokens */
    --color-primary: #3B82F6;
    --color-primary-hover: #60A5FA;
    --color-accent: #00F5FF;
    --color-accent-subtle: rgba(0, 245, 255, 0.15);

    /* Feedback & Status */
    --color-success: #10B981;
    --color-warning: #F59E0B;
    --color-error: #EF4444;

    /* Typography Color */
    --color-text-primary: #F8FAFC;
    --color-text-secondary: #94A3B8;
    --color-text-muted: #64748B;

    /* Metrics & Spacing */
    --spacing-xxs: 4px;
    --spacing-xs: 8px;
    --spacing-sm: 12px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;

    /* Radius */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-full: 9999px;

    /* Typography Sizing */
    --font-size-xs: 11px;
    --font-size-sm: 13px;
    --font-size-md: 15px;
    --font-size-lg: 18px;
    --font-size-xl: 24px;
    --font-size-hero: 32px;
}

/* Base Component Styles */
.panel-root {
    background-color: var(--color-bg-surface);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.button-primary {
    background-color: var(--color-primary);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    border-radius: var(--radius-sm);
    padding-top: var(--spacing-xs);
    padding-bottom: var(--spacing-xs);
    padding-left: var(--spacing-md);
    padding-right: var(--spacing-md);
    border-width: 0;
    transition-duration: 0.15s;
}

.button-primary:hover {
    background-color: var(--color-primary-hover);
}

.label-title {
    color: var(--color-text-primary);
    font-size: var(--font-size-xl);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-sm);
}

.label-body {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
}
