<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement class="panel-root" style="width: 100%; height: 100%; justify-content: center; align-items: center;">
        <ui:VisualElement style="background-color: var(--color-bg-elevated); padding: var(--spacing-xl); border-radius: var(--radius-lg); border-width: 1px; border-color: var(--color-border); min-width: 480px; align-items: center;">
            <ui:Label text="ENTERPRISE URP MASTER" name="title-label" class="label-title" />
            <ui:Label text="Zero-Allocation • Modular Architecture • UI Toolkit Integrated" name="subtitle-label" class="label-body" style="margin-bottom: var(--spacing-lg);" />
            <ui:Button text="Initialize Experience" name="primary-action-btn" class="button-primary" style="min-width: 200px; height: 42px;" />
            <ui:Label text="Ready" name="status-label" class="label-body" style="margin-top: var(--spacing-md); color: var(--color-accent);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
